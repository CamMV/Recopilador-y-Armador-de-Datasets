# Copiar a .env y rellenar solo lo que se vaya a usar.

# --- YouTube (opcional) ---------------------------------------------------
# Sin esta variable la aplicacion funciona igual, buscando con yt-dlp.
# Obtener la key en https://console.cloud.google.com -> APIs -> YouTube Data API v3
YOUTUBE_API_KEY=

# --- Instagram (obligatorio para Instagram, elegir UNA opcion) -----------
# Recomendado: no poner nada aqui y ejecutar una vez
#     python main.py --login instagram
# Alternativas: la cookie "sessionid" de un navegador con la sesion iniciada...
INSTAGRAM_SESSIONID=
# ...o usuario y contrasena (usa una cuenta secundaria, no la personal).
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- TikTok ---------------------------------------------------------------
# La busqueda necesita una sesion iniciada en el navegador del proyecto:
#     python main.py --login tiktok
# 1 = navegador oculto. TikTok suele bloquearlo; dejar vacio salvo en servidores.
RECOPILADOR_NAVEGADOR_OCULTO=
